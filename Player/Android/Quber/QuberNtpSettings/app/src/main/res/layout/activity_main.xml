<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title"
            android:textColor="#111111"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/description"
            android:textColor="#555555"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="640dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:background="#F1F3F5"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/current_server_label"
                android:textColor="#555555"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/current_server"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/loading"
                android:textColor="#111111"
                android:textIsSelectable="true"
                android:textSize="23sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/auto_time_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/auto_time_off"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <EditText
            android:id="@+id/server_input"
            android:layout_width="640dp"
            android:layout_height="56dp"
            android:layout_marginTop="22dp"
            android:autofillHints=""
            android:hint="@string/server_hint"
            android:imeOptions="actionDone"
            android:inputType="textUri"
            android:maxLines="1"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:selectAllOnFocus="true"
            android:textSize="20sp" />

        <LinearLayout
            android:layout_width="640dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/refresh_button"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="@string/refresh" />

            <Space
                android:layout_width="16dp"
                android:layout_height="1dp" />

            <Button
                android:id="@+id/apply_button"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="@string/apply" />
        </LinearLayout>

        <Button
            android:id="@+id/date_settings_button"
            android:layout_width="640dp"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:text="@string/open_date_settings" />

        <TextView
            android:id="@+id/status"
            android:layout_width="640dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:minHeight="48dp"
            android:text="@string/status_connecting"
            android:textColor="#333333"
            android:textSize="16sp" />
    </LinearLayout>
</ScrollView>
